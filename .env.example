# Viaggio 2.0 Environment Configuration

# Django Settings
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=django-insecure-viaggio-dev-secret-key-change-in-production-2026!#
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend,web

# Database (PostgreSQL + PostGIS)
POSTGRES_DB=viaggio
POSTGRES_USER=viaggio_user
POSTGRES_PASSWORD=viaggio_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgis://viaggio_user:viaggio_password@postgres:5432/viaggio

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Channels (ASGI / WebSockets)
CHANNELS_REDIS_URL=redis://redis:6379/3

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM Providers (Optional for Phase 1, configurable)
VIAGGIO_LLM_PROVIDER=rule_based
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Routing (OSRM)
OSRM_BASE_URL=http://localhost:5000

# Fallback SQLite for local quick unit tests without PostGIS installed on host OS
USE_SQLITE=False
